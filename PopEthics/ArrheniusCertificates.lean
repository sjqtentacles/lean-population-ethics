/-- No axiology satisfies Trans, ED, Quantity, AvoidRC (with the witnesses shown).
Certificate: 7 ground instances (3 of Trans, 1 of ED, 2 of Quantity, 1 of AvoidRC). -/
theorem conflict_trans_ED_Quantity_AvoidRC {R : Axiology}
    (hT : Trans R)
    (hED : ED R (-1) 5)
    (hQ : Quantity R (-1) 5 (fun _ m => 2 * m))
    (hARC : AvoidRC R 4 1) : False := by
  have i1 := hT.inst [2, 2, 2, 2] [3, 3] [4]
  have i2 := hT.inst [2, 2, 2, 2] [4] [3, 3, 3, 3]
  have i3 := hT.inst [3, 3, 3, 3] [2, 2, 2, 2] [4]
  have i4 : R (pop [3, 3, 3, 3]) (pop [2, 2, 2, 2]) ∧ ¬ R (pop [2, 2, 2, 2]) (pop [3, 3, 3, 3]) :=
    better_perm (hED 2 3 4 (by decide) (by decide) (by decide) (by decide)) (by decide) (by decide)
  have i5 : R (pop [2, 2, 2, 2]) (pop [3, 3]) :=
    rel_perm (hQ 3 2 (by decide) (by decide) (by decide)) (by decide) (by decide)
  have i6 : R (pop [3, 3]) (pop [4]) :=
    rel_perm (hQ 4 1 (by decide) (by decide) (by decide)) (by decide) (by decide)
  have i7 : ¬ (R (pop [3, 3, 3, 3]) (pop [4]) ∧ ¬ R (pop [4]) (pop [3, 3, 3, 3])) :=
    not_better_perm (hARC 4 (by decide)) (by decide) (by decide)
  clear hT hED hQ hARC
  grind

